# ===== Frontend (valori pubblici, incorporati nel build) =====
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ===== Server Node (variabili del pannello Hostinger: MAI nel repository) =====
# Dominio pubblico: canonical, Open Graph, sitemap.xml e robots.txt
SITE_URL=https://cubeacademy.eu
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Sandbox/live, metodi attivi, sconto privati e codici sconto si gestiscono dal pannello (#/admin/impostazioni).
# Qui servono solo le chiavi: *_TEST per la sandbox, senza suffisso per il live.

# Stripe (stessi nomi di romaofficesharing)
STRIPE_SECRET_TEST=sk_test_REPLACE
STRIPE_WEBHOOK_SECRET_TEST=whsec_REPLACE
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID_TEST=
PAYPAL_SECRET_TEST=
PAYPAL_WEBHOOK_ID_TEST=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_WEBHOOK_ID=
# PAYPAL_API_URL=https://api-m.paypal.com

# SumUp
SUMUP_API_KEY_TEST=
SUMUP_MERCHANT_CODE_TEST=
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Email di conferma (SMTP Hostinger: smtp.hostinger.com, porta 465)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=info@cubeacademy.eu
MAIL_FROM_NAME=Cube Academy
# MAIL_STAFF_TO: riepilogo interno e messaggi del modulo di contatto; MAIL_STAFF_CC: copia delle conferme inviate ai clienti
# (entrambi con default info@cubeacademy.eu)
MAIL_STAFF_TO=info@cubeacademy.eu
MAIL_STAFF_CC=info@cubeacademy.eu

# Traduzione automatica dei testi nel pannello (pulsante "Traduci per le altre lingue", facoltativo).
# Con ANTHROPIC_API_KEY usa Claude (migliore); senza chiave usa il servizio gratuito MyMemory
# (limite giornaliero; TRANSLATE_EMAIL = un tuo indirizzo email lo alza).
# ANTHROPIC_API_KEY=
# TRANSLATE_MODEL=claude-haiku-5-5
# TRANSLATE_EMAIL=

# Statistiche (facoltativo): Google Tag Manager, caricato solo dopo il consenso ai cookie analitici
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Bonifico
BANK_HOLDER=Cube Engineering S.r.l.
BANK_NAME=
BANK_IBAN=
BANK_BIC=
