# Copia in .env e compila con i dati del database MySQL/MariaDB di Hostinger
# (hPanel > Database > Gestione)
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# nome della tabella corsi (nel dump attuale: wp_corsi)
CORSI_TABLE=wp_corsi
# stringa lunga casuale, per firmare la sessione admin
JWT_SECRET=
PORT=3001
